# ─────────────────────────────────────────────────────────────
# Variáveis de Ambiente - public-audit-agent
# ─────────────────────────────────────────────────────────────
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env com chaves reais!

# ─────────────────────────────────────────────────────────────
# API Keys (Obrigatórias)
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here
GOOGLE_API_KEY=your-google-api-key-here

# ─────────────────────────────────────────────────────────────
# Docker / Container (Para deploy containerizado)
# ─────────────────────────────────────────────────────────────
DOCKER_NETWORK_NAME=public-audit-agent_net
MCP_HOST=app
MCP_PORT=8000

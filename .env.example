# ─────────────────────────────────────────────────────────────
# Variáveis de Ambiente - public-audit-agent
# ─────────────────────────────────────────────────────────────
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env com chaves reais!

# ─────────────────────────────────────────────────────────────
# API Keys (Obrigatórias)
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here
GOOGLE_API_KEY=your-google-api-key-here

# ─────────────────────────────────────────────────────────────
# Docker / Container (Para deploy containerizado)
# ─────────────────────────────────────────────────────────────
DOCKER_NETWORK_NAME=public-audit-agent_net
MCP_HOST=app
MCP_PORT=8000

# ─────────────────────────────────────────────────────────────
# Airflow (Para orquestração ETL)
# ─────────────────────────────────────────────────────────────
# UID do host para evitar problemas de permissão nos volumes Docker
# Gerado automaticamente por 'make airflow-up'
AIRFLOW_UID=1000
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=change-me-in-production
AIRFLOW_ADMIN_USER=
AIRFLOW_ADMIN_PASSWORD=
# Postgres interno do Airflow (metadados do scheduler)
AIRFLOW_PG_USER=
AIRFLOW_PG_PASSWORD=
AIRFLOW_PG_DB=
